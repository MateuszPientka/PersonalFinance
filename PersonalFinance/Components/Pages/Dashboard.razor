@page "/"
@using PersonalFinance.Data
@using PersonalFinance.Models
@using Microsoft.EntityFrameworkCore

@inject AppDbContext context;
@inject NavigationManager Nav

@rendermode InteractiveServer

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0">Dashboard</h2>
        <span class="text-muted">Witaj ponownie!</span>
    </div>

    <div class="row mb-4">
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card bg-primary shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-white-50">Aktualne Saldo</h6>
                    <h3 class="mb-0">12,450.00 PLN</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-6 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Przychody (Maj)</h6>
                    <h3 class="text-success mb-0">+ 8,200.00 PLN</h3>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-md-12 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="text-muted">Wydatki (Maj)</h6>
                    <h3 class="text-danger mb-0">- 3,150.00 PLN</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8 mb-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Wydatki w tym tygodniu</span>
                    <button class="btn btn-sm btn-outline-secondary">Szczegóły</button>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center" style="min-height: 300px;">
                    <div class="text-center">
                        <i class="bi bi-graph-up mb-3 d-block" style="font-size: 2rem; color: var(--accent);"></i>
                        <span class="text-muted">[Miejsce na wykres dynamiczny]</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    Ostatnie transakcje
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold">Zakupy spożywcze</div>
                                <small class="text-muted small">Dzisiaj, 14:20</small>
                            </div>
                            <span class="amount-expense">-120.00 PLN</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold">Wypłata</div>
                                <small class="text-muted small">Wczoraj</small>
                            </div>
                            <span class="amount-income">+5,000.00 PLN</span>
                        </div>
                        <div class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-bold">Paliwo</div>
                                <small class="text-muted small">12 Maj</small>
                            </div>
                            <span class="amount-expense">-300.00 PLN</span>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-center">
                    <a href="/transactions" class="btn btn-sm btn-link text-accent">Zobacz wszystko</a>
                </div>
            </div>
        </div>
    </div>
</div>


@code {
	private List<Transaction> lastFiveTransactions = new();

	protected override async Task OnInitializedAsync()
	{
		lastFiveTransactions = await context.Transactions.OrderByDescending(t => t.Id).Take(5).ToListAsync();
	}
}
