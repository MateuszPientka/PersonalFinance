@page "/transactions"
@using PersonalFinance.Data
@using PersonalFinance.Models
@using Microsoft.EntityFrameworkCore
@using PersonalFinance.Services

@inject AppDbContext context
@inject CurrencyService CurrencySvc
@inject NavigationManager Nav
@rendermode InteractiveServer

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="m-0">Transaction History</h2>
        <a href="/addTransaction" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Add New
        </a>
    </div>

    <div class="card bg-dark border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small text-muted">Search</label>
                    <input type="text" class="form-control bg-transparent border-secondary text-white"
                           placeholder="Category or amount..." @bind="searchTerm" @bind:event="oninput" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted">Type</label>
                    <select class="form-select bg-transparent border-secondary text-white" @bind="filterType">
                        <option value="">All Types</option>
                        <option value="Income">Income</option>
                        <option value="Expense">Expense</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">From Date</label>
                    <input type="date" class="form-control bg-transparent border-secondary text-white" @bind="fromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">To Date</label>
                    <input type="date" class="form-control bg-transparent border-secondary text-white" @bind="toDate" />
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">Reset</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="card bg-dark border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
            <table class="table table-dark table-hover mb-0">
                <thead class="table-light text-dark">
                    <tr>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Type</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end">Value in PLN</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in FilteredTransactions)
                    {
                        <tr>
                            <td class="align-middle">@t.Date.ToString("dd.MM.yyyy")</td>
                            <td class="align-middle">
                                <div class="d-flex align-items-center">
                                    <i class="bi @t.Category?.Icon me-2 text-primary"></i>
                                    @t.Category?.Name
                                </div>
                            </td>
                            <td class="align-middle">
                                <span class="badge @(t.Type == TransactionType.Income ? "bg-success" : "bg-danger")">
                                    @t.Type
                                </span>
                            </td>
                            <td class="text-end align-middle fw-bold">
                                @t.Amount.ToString("N2") @t.CurrencyCode
                            </td>
                            <td class="text-end align-middle text-muted small">
                                @t.AmountPLN.ToString("N2") PLN
                            </td>
                            <td class="text-center align-middle">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-info" title="Edit" @onclick="() => OpenEditModal(t)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" title="Delete" @onclick="() => OpenDeleteModal(t)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!FilteredTransactions.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">No transactions found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showDeleteModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title text-danger">Confirm Delete</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete this transaction?</p>
                    @if (transactionToDelete != null)
                    {
                        <div class="p-3 bg-secondary bg-opacity-10 rounded">
                            <strong>@transactionToDelete.Category?.Name</strong><br />
                            <span class="text-muted">@transactionToDelete.Amount @transactionToDelete.CurrencyCode (@transactionToDelete.Date.ToShortDateString())</span>
                        </div>
                    }
                </div>
                <div class="modal-footer border-secondary">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">Delete Permanently</button>
                </div>
            </div>
        </div>
    </div>
}

@if (showEditModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <EditForm Model="editModel" OnValidSubmit="HandleEditSubmit">
                    <DataAnnotationsValidator />
                    <div class="modal-header border-secondary">
                        <h5 class="modal-title">Edit Transaction</h5>
                        <button type="button" class="btn-close btn-close-white" @onclick="() => showEditModal = false"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-muted small">Amount</label>
                            <div class="input-group">
                                <InputNumber @bind-Value="editModel.Amount" class="form-control bg-transparent text-white border-secondary" />
                                <InputSelect @bind-Value="editModel.CurrencyCode" class="form-select bg-transparent text-white border-secondary" style="max-width: 100px;">
                                    <option value="PLN">PLN</option>
                                    <option value="USD">USD</option>
                                    <option value="EUR">EUR</option>
                                    <option value="GBP">GBP</option>
                                </InputSelect>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small">Category</label>
                            <InputSelect @bind-Value="editModel.CategoryId" class="form-select bg-transparent text-white border-secondary">
                                @foreach (var cat in categories.Where(c => c.IsIncome == (editModel.Type == TransactionType.Income)))
                                {
                                    <option value="@cat.Id">@cat.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-muted small">Date</label>
                            <InputDate @bind-Value="editModel.Date" class="form-control bg-transparent text-white border-secondary" />
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline-secondary" @onclick="() => showEditModal = false">Cancel</button>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private List<Transaction> allTransactions = new();
    private string searchTerm = "";
    private string filterType = "";
    private DateTime? fromDate;
    private DateTime? toDate;

    private bool showDeleteModal = false;
    private Transaction? transactionToDelete;

    private bool showEditModal = false;
    private Transaction editModel = new();
    private List<Category> categories = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadTransactions();
        categories = await context.Categories.ToListAsync();
    }

    private async Task LoadTransactions()
    {
        allTransactions = await context.Transactions
            .Include(t => t.Category)
            .OrderByDescending(t => t.Date)
            .ToListAsync();
    }

    private IEnumerable<Transaction> FilteredTransactions => allTransactions
        .Where(t =>
            (string.IsNullOrEmpty(searchTerm) || t.Category.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || t.Amount.ToString().Contains(searchTerm)) &&
            (string.IsNullOrEmpty(filterType) || t.Type.ToString() == filterType) &&
            (!fromDate.HasValue || t.Date >= DateTime.SpecifyKind(fromDate.Value, DateTimeKind.Utc)) &&
            (!toDate.HasValue || t.Date <= DateTime.SpecifyKind(toDate.Value, DateTimeKind.Utc))
        );

    private void ResetFilters()
    {
        searchTerm = "";
        filterType = "";
        fromDate = null;
        toDate = null;
    }

    private void OpenDeleteModal(Transaction t)
    {
        transactionToDelete = t;
        showDeleteModal = true;
    }

    private void CloseModal()
    {
        transactionToDelete = null;
        showDeleteModal = false;
    }

    private async Task ConfirmDelete()
    {
        if (transactionToDelete != null)
        {
            context.Transactions.Remove(transactionToDelete);
            await context.SaveChangesAsync();

            await LoadTransactions();
            CloseModal();
        }
    }

    private void OpenEditModal(Transaction t)
    {
        editModel = new Transaction
            {
                Id = t.Id,
                Amount = t.Amount,
                CurrencyCode = t.CurrencyCode,
                Date = t.Date,
                CategoryId = t.CategoryId,
                Type = t.Type,
                AmountPLN = t.AmountPLN
            };
        showEditModal = true;
    }

    private async Task HandleEditSubmit()
    {
        try
        {
            var dbTransaction = await context.Transactions.FindAsync(editModel.Id);
            if (dbTransaction == null) return;

            var newDateUtc = DateTime.SpecifyKind(editModel.Date.Date, DateTimeKind.Utc);
            var oldDateUtc = DateTime.SpecifyKind(dbTransaction.Date.Date, DateTimeKind.Utc);

            bool dateChanged = oldDateUtc != newDateUtc;
            bool currencyChanged = dbTransaction.CurrencyCode != editModel.CurrencyCode;
            bool amountChanged = dbTransaction.Amount != editModel.Amount;

            if (dateChanged || currencyChanged || amountChanged)
            {
                decimal rate = await CurrencySvc.GetRateForDate(editModel.CurrencyCode, newDateUtc);
                editModel.AmountPLN = editModel.Amount * rate;
            }

            dbTransaction.Amount = editModel.Amount;
            dbTransaction.CurrencyCode = editModel.CurrencyCode;
            dbTransaction.Date = newDateUtc;
            dbTransaction.CategoryId = editModel.CategoryId;
            dbTransaction.Type = editModel.Type;
            dbTransaction.AmountPLN = editModel.AmountPLN;

            await context.SaveChangesAsync();

            await LoadTransactions();
            showEditModal = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Błąd podczas edycji: {ex.Message}");
        }
    }
}